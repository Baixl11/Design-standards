{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed design tokens",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "$description": {
      "type": "string",
      "minLength": 1
    },
    "$extensions": {
      "$ref": "#/$defs/rootExtensions"
    }
  },
  "patternProperties": {
    "^(?!\\$).*": {
      "$ref": "#/$defs/node"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/token"
        },
        {
          "$ref": "#/$defs/group"
        }
      ]
    },
    "group": {
      "type": "object",
      "properties": {
        "$description": {
          "type": "string",
          "minLength": 1
        },
        "$type": {
          "type": "string",
          "minLength": 1
        },
        "$extensions": {
          "type": "object"
        }
      },
      "patternProperties": {
        "^(?!\\$).*": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "required": [
        "$type",
        "$value",
        "$description",
        "$extensions"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1
        },
        "$value": {
          "not": {
            "enum": [
              null,
              ""
            ]
          }
        },
        "$description": {
          "type": "string",
          "minLength": 1
        },
        "$extensions": {
          "type": "object",
          "required": [
            "style-design-spec"
          ],
          "properties": {
            "style-design-spec": {
              "$ref": "#/$defs/evidence"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "status",
        "evidenceIds",
        "confidence",
        "confidenceReason",
        "scope"
      ],
      "properties": {
        "status": {
          "enum": [
            "measured",
            "sampled",
            "observed",
            "inferred",
            "adapted"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E-[0-9]{3,}$"
          },
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "confidenceReason": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "minProperties": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "adapted"
              }
            }
          },
          "then": {
            "required": [
              "rationale"
            ]
          },
          "else": {
            "properties": {
              "evidenceIds": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "rootExtensions": {
      "type": "object",
      "required": [
        "style-design-spec"
      ],
      "properties": {
        "style-design-spec": {
          "type": "object",
          "required": [
            "formatVersion",
            "generatedAt",
            "targets",
            "documentStatus"
          ],
          "properties": {
            "formatVersion": {
              "type": "string",
              "minLength": 1
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "documentStatus": {
              "enum": [
                "draft",
                "partial",
                "verified"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  }
}
